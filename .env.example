# Copy to .env and fill in. Never commit .env. Testnet values only.

# Arkiv (Tiramisu testnet)
ARKIV_RPC_URL=https://rpc.tiramisu.db-chain.testnet.arkiv.network
ARKIV_CHAIN_ID=7738577
ARKIV_PRIVATE_KEY=

# Swarm (Bee node API and postage batch)
BEE_API_URL=http://localhost:1633
SWARM_POSTAGE_BATCH_ID=
SWARM_GATEWAY_URL=

# Hydra API
HYDRA_API_PORT=8787
HYDRA_API_KEYS=   # comma-separated "team:key" pairs for the demo

# filebus research tools (/research, /deep, /swarm, /board) — kit in .filebus/
GROQ_KEY=
TAVILY_KEY=
JINA_KEY=
GLM_KEY=
