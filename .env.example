# Copy to .env and fill in. Never commit .env. Testnet values only.

# Arkiv (Rabdi testnet, chain 7794095). Tiramisu is replaced; do not use it.
ARKIV_RPC_URL=https://rpc.rabdi.db-chain.testnet.arkiv.network
ARKIV_WS_URL=wss://rpc.rabdi.db-chain.testnet.arkiv.network
ARKIV_CHAIN_ID=7794095
ARKIV_ACCESS_KEY=   # from hub.arkiv.network/access-keys; the public RPC is rate limited
ARKIV_PRIVATE_KEY=

# Swarm (Bee node API and postage batch).
# Path B (confirmed 2026-11-05, spikes/F2/result.json): use the EF public gateway,
# leave SWARM_POSTAGE_BATCH_ID empty (the gateway envelope-stamps for us).
# HTML files are blocked by the public gateway (302 to bzz.link/forbidden); JSON/JS/CSS/binary work.
BEE_API_URL=https://api.gateway.ethswarm.org
SWARM_POSTAGE_BATCH_ID=
SWARM_GATEWAY_URL=https://api.gateway.ethswarm.org

# Hydra API
HYDRA_API_PORT=8787
HYDRA_ALLOWED_ADDRESSES=   # optional comma-separated wallets allowed to get keys; empty = anyone
HYDRA_PUBLISHES_PER_HOUR=30
HYDRA_PUBLISHER_ADDRESS=   # read-only API only: the wallet whose records reads trust

# Demo live checker (T-A25): the token that switches the 5-second watcher on or off from the explorer's
# Live page. At least 16 characters; without it POST /v1/watch answers 503. Never commit a real one.
DEMO_WATCH_TOKEN=

# Alert channels (T-A30): seals each app's webhook, Slack, Discord or Telegram target before it is
# stored on Arkiv. 64 hex characters (32 bytes); without it the /v1/alerts routes answer 503.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it makes every stored channel unreadable (teams must add them again). Never commit a real one.
ALERT_KEY=
# The Telegram bot that sends the Hydra team alerts (TELEGRAM_CHAT_ID) and, when set, apps' Telegram channels.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
